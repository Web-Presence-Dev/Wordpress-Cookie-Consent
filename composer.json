{
    "name": "web-presence-dev/wordpress-cookie-consent",
    "description": "Cookie consent banner that finds and blocks GA4 and other tracking until visitors agree.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        { "name": "Web Presence", "homepage": "https://webpresence.digital/" }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.0 || ^2.0"
    },
    "extra": {
        "installer-name": "webpresence-cookie-consent"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
